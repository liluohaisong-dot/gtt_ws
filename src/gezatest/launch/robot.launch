<launch>

    <param name="robot_description" command="$(find xacro)/xacro $(find gezatest)/xacro/robot.xacro" />
  
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find gezatest)/world/1.world" />
    </include>
  
    <node pkg="gazebo_ros" type="spawn_model" name="model" args="-urdf -model mycar -param robot_description" />
</launch>